{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modeltopography.com/schema/aggregate.schema.json",
  "title": "MTB aggregate",
  "description": "Retired version 0.8 aggregate proposal. Do not generate current X or MTB scores from this schema. Replacement pending scoring validation; see SPEC.md and schema/README.md.",
  "deprecated": true,
  "$comment": "Historical draft retained for traceability. No published aggregates or running consumers exist.",
  "type": "object",
  "required": ["model_id", "tier", "set_version", "runs", "x", "y", "z", "mtb"],
  "properties": {
    "model_id": { "type": "string" },
    "display_name": { "type": "string" },
    "vendor": { "type": "string" },
    "tier": { "type": "integer", "enum": [1, 2, 3] },
    "set_version": { "type": "string" },
    "computed_at": { "type": "string", "format": "date-time" },
    "runs": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "successes": { "type": "integer" },
        "by_trust_level": { "type": "object", "additionalProperties": { "type": "integer" } },
        "reference_harness_only": { "type": "boolean" }
      }
    },
    "x": {
      "type": "object",
      "description": "Trusted width",
      "properties": {
        "p_window": { "type": "number", "description": "Failure rate per 10 minute window" },
        "hours_at_90": { "type": "number" },
        "hours_at_95": { "type": "number" },
        "ci_low": { "type": "number" },
        "ci_high": { "type": "number" }
      }
    },
    "y": {
      "type": "object",
      "description": "Intelligence",
      "properties": {
        "eci": { "type": "number" },
        "source": { "type": "string", "enum": ["eci", "aaii_capped"] },
        "as_of": { "type": "string", "format": "date" }
      }
    },
    "z": {
      "type": "object",
      "description": "Cost efficiency",
      "properties": {
        "success_rate": { "type": "number" },
        "mean_cost_per_attempt_usd": { "type": "number" },
        "task_hours": { "type": "number" },
        "successful_hours_per_usd": { "type": "number" }
      }
    },
    "mtb": { "type": "number", "description": "Cube root of x.hours_at_90 * y.eci * z.successful_hours_per_usd" }
  }
}
