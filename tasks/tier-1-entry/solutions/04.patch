--- /dev/null
+++ b/db/migrations/001-preserve-invoices.sql
@@ -0,0 +1,20 @@
+PRAGMA foreign_keys = OFF;
+BEGIN;
+CREATE TABLE invoices_next (
+  id INTEGER PRIMARY KEY,
+  client_id INTEGER REFERENCES clients(id) ON DELETE SET NULL,
+  client_name TEXT NOT NULL DEFAULT '',
+  number TEXT NOT NULL,
+  issued_on TEXT NOT NULL,
+  due_on TEXT NOT NULL,
+  status TEXT NOT NULL DEFAULT 'unpaid',
+  deleted_at TEXT,
+  created_at TEXT NOT NULL
+);
+INSERT INTO invoices_next (id, client_id, client_name, number, issued_on, due_on, status, deleted_at, created_at)
+SELECT i.id, i.client_id, COALESCE(c.name, ''), i.number, i.issued_on, i.due_on, i.status, i.deleted_at, i.created_at
+FROM invoices i LEFT JOIN clients c ON c.id = i.client_id;
+DROP TABLE invoices;
+ALTER TABLE invoices_next RENAME TO invoices;
+COMMIT;
+PRAGMA foreign_keys = ON;
